---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
const isLocal = typeof src === 'object';
---

<figure class={`figure ${wide ? 'figure-wide' : ''}`}>
  <div class="figure-frame">
    {isLocal ? (
      <Image src={src as ImageMetadata} alt={alt} loading="lazy" />
    ) : (
      <img src={src as string} alt={alt} loading="lazy" />
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2.5rem 0;
  }

  .figure-frame {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--color-surface);
  }

  .figure-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .figure-wide {
    width: 100%;
    max-width: 960px;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 1040px) {
    .figure-wide {
      max-width: 100%;
      margin-left: 0;
      transform: none;
    }
  }
</style>
