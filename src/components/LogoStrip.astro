---
import { orgs } from '../data/orgs';
---

<section class="logos" aria-labelledby="logos-title">
  <div class="container logos-inner">
    <p id="logos-title" class="mono logos-label">Where I've built</p>
    <ul class="logo-row" role="list">
      {orgs.map(o => {
        const content = o.logo
          ? <img src={o.logo} alt={o.name} loading="lazy" />
          : <span class="wordmark">{o.name}</span>;
        return (
          <li>
            {o.href
              ? <a href={o.href} target="_blank" rel="noopener noreferrer" title={`${o.name} ↗`}>{content}</a>
              : <span class="no-link">{content}</span>}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .logos { padding: 1.75rem 0 0.5rem; }

  .logos-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .logos-label {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .logo-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2.25rem;
  }

  .logo-row a,
  .logo-row .no-link {
    display: flex;
    align-items: center;
    height: 32px;
    opacity: 0.55;
    filter: grayscale(1);
    transition: opacity 0.2s, filter 0.2s;
  }

  .logo-row a:hover,
  .logo-row a:focus-visible {
    opacity: 1;
    filter: none;
  }

  .logo-row img {
    height: 26px;
    width: auto;
    max-width: 130px;
    object-fit: contain;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--color-text);
  }

  .logo-row a:hover .wordmark { color: var(--color-accent); }

  @media (prefers-color-scheme: dark) {
    .logo-row img { filter: grayscale(1) invert(1) brightness(1.4); }
    .logo-row a:hover img { filter: none; }
  }

  @media (max-width: 760px) {
    .logos-inner { flex-direction: column; align-items: flex-start; gap: 0.9rem; }
    .logo-row { gap: 0.6rem 1.5rem; }
    .wordmark { font-size: 1rem; }
  }
</style>
