---
import { orgs } from '../data/orgs';
---

<section class="logos" aria-labelledby="logos-title">
  <div class="container logos-inner">
    <p id="logos-title" class="mono logos-label">Where I've built</p>
    <ul class="logo-row" role="list">
      {orgs.map(o => {
        const Tag = o.href ? 'a' : 'span';
        const linkProps = o.href
          ? { href: o.href, target: '_blank', rel: 'noopener noreferrer', title: `${o.name} ↗` }
          : {};
        return (
          <li>
            <Tag class="org" {...linkProps}>
              {o.logo && o.mark && (
                <span
                  class="logo-mask"
                  style={`--logo: url('${o.logo}'); --ratio: ${o.ratio ?? 1}; --scale: ${o.scale ?? 1};`}
                  aria-hidden="true"
                />
              )}
              <span class="wordmark">{o.name}</span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .logos { padding: 1.75rem 0 0.5rem; }

  .logos-inner { display: flex; align-items: center; gap: 1.5rem; }

  .logos-label { flex-shrink: 0; color: var(--color-text-muted); }

  .logo-row { list-style: none; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

  /* Every org is the same badge: optional small mark + name. */
  .org {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 36px;
    padding: 0 0.95rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-secondary);
    transition: background 0.2s, color 0.2s, transform 0.3s var(--ease-out);
  }

  a.org:hover,
  a.org:focus-visible {
    background: var(--color-accent-light);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .logo-mask {
    display: block;
    height: calc(18px * var(--scale, 1));
    aspect-ratio: var(--ratio);
    background-color: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  .wordmark { font-size: 0.92rem; font-weight: 500; letter-spacing: -0.01em; white-space: nowrap; }

  @media (max-width: 760px) {
    .logos-inner { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .org { height: 32px; padding: 0 0.8rem; }
    .wordmark { font-size: 0.85rem; }
  }
</style>
