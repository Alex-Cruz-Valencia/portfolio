---
import { orgs } from '../data/orgs';
---

<section class="logos" aria-labelledby="logos-title">
  <div class="container logos-inner">
    <h2 id="logos-title" class="logos-label">Places I've built with</h2>
    <div class="logo-viewport">
      <div class="logo-track">
    <ul class="logo-row" role="list">
      {orgs.map(o => {
        const Tag = o.href ? 'a' : 'span';
        const linkProps = o.href
          ? { href: o.href, target: '_blank', rel: 'noopener noreferrer', title: `${o.name} ↗` }
          : {};
        return (
          <li>
            <Tag class:list={['org', { 'has-mark': o.logo && o.mark }]} {...linkProps}>
              {o.logo && (
                <span
                  class:list={['logo-mask', { 'is-mark': o.mark }]}
                  style={`--logo: url('${o.logo}'); --ratio: ${o.ratio ?? 3}; --scale: ${o.scale ?? 1};`}
                  role="img"
                  aria-label={o.mark ? undefined : o.name}
                  aria-hidden={o.mark ? 'true' : undefined}
                />
              )}
              {(!o.logo || o.mark) && <span class="wordmark">{o.name}</span>}
            </Tag>
          </li>
        );
      })}
    </ul>
    <ul class="logo-row" role="list" aria-hidden="true">
      {orgs.map(o => {
        const Tag = o.href ? 'a' : 'span';
        const linkProps = o.href
          ? { href: o.href, target: '_blank', rel: 'noopener noreferrer', title: `${o.name} ↗` }
          : {};
        return (
          <li>
            <Tag class:list={['org', { 'has-mark': o.logo && o.mark }]} {...linkProps} tabindex={o.href ? -1 : undefined}>
              {o.logo && (
                <span
                  class:list={['logo-mask', { 'is-mark': o.mark }]}
                  style={`--logo: url('${o.logo}'); --ratio: ${o.ratio ?? 3}; --scale: ${o.scale ?? 1};`}
                  role="img"
                  aria-label={o.mark ? undefined : o.name}
                  aria-hidden={o.mark ? 'true' : undefined}
                />
              )}
              {(!o.logo || o.mark) && <span class="wordmark">{o.name}</span>}
            </Tag>
          </li>
        );
      })}
    </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .logos { padding: 1.75rem 0 0.5rem; }

  .logos-inner {
    display: flex;
    align-items: center;
    position: relative;
  }

  /* Kept for screen readers; the strip itself carries the meaning visually. */
  .logos-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; margin: 0; }

  .logo-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.85rem;
  }

  .org {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 34px;
    color: var(--color-text);
    opacity: 0.55;
    transition: opacity 0.2s, color 0.2s;
  }

  a.org:hover,
  a.org:focus-visible {
    opacity: 1;
    color: var(--color-accent);
  }

  /* One-color silhouette: the logo's shape, painted with currentColor. */
  .logo-mask {
    display: block;
    height: calc(20px * var(--scale, 1));
    aspect-ratio: var(--ratio);
    background-color: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  .logo-mask.is-mark { height: calc(28px * var(--scale, 1)); }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .logos-inner { flex-direction: column; align-items: flex-start; gap: 0.9rem; }
    .logo-row { gap: 0.7rem 1.6rem; }
    .wordmark { font-size: 1rem; }
    .logo-mask { height: calc(17px * var(--scale, 1)); }
    .logo-mask.is-mark { height: calc(24px * var(--scale, 1)); }
  }

  /* ── Gentle loop: two copies of the row slide left forever, pause on hover/focus ── */
  .logo-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .logo-track { display: flex; width: max-content; }
  .logo-track .logo-row { flex-wrap: nowrap; flex-shrink: 0; padding-right: 3rem; gap: 3rem; }
  .logo-track .logo-row[aria-hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .logo-track .logo-row[aria-hidden] { display: flex; }
    .logo-track { animation: logo-loop 45s linear infinite; }
    .logo-viewport:hover .logo-track,
    .logo-viewport:focus-within .logo-track { animation-play-state: paused; }
    @keyframes logo-loop { to { transform: translateX(-50%); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-viewport { -webkit-mask-image: none; mask-image: none; }
    .logo-track { width: auto; }
    .logo-track .logo-row { flex-wrap: wrap; gap: 0.9rem 1.85rem; padding-right: 0; }
  }
  @media (max-width: 760px) { .logo-viewport { width: 100%; } }
</style>
