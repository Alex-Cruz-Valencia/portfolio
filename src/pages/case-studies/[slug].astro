---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map(study => ({
    params: { slug: study.id },
    props: study,
  }));
}

const study = Astro.props;
const { Content } = await render(study);
const d = study.data;

const allStudies = (await getCollection('caseStudies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const currentIndex = allStudies.findIndex(s => s.id === study.id);
const nextStudy = allStudies[currentIndex + 1] ?? allStudies[0];
const prevStudy = allStudies[currentIndex - 1] ?? null;

const glance = [
  { label: 'Role', value: d.role },
  { label: 'Where', value: d.org },
  { label: 'Team', value: d.team },
  { label: 'When', value: d.date },
].filter(g => g.value);
---

<Layout title={d.title} description={d.excerpt}>

  <div id="reading-progress" aria-hidden="true"></div>

  <article>

    <header class="case-header">
      <div class="content-width">
        <a href="/#work" class="back-link mono">← All work</a>
        <p class="eyebrow case-kicker">
          {d.mascot && <img class="case-mascot" src={d.mascot} alt="" width="44" height="59" />}
          <span>
            Case study {String(currentIndex + 1).padStart(2, '0')}
            {d.readTime && <span class="case-read">{' · '}{d.readTime}</span>}
          </span>
        </p>
        <h1 transition:name={`title-${study.id}`}>{d.title}</h1>
        {d.subtitle && <p class="mono case-sub">{d.subtitle}</p>}
        <p class="case-excerpt">{d.excerpt}</p>
        {d.story && glance.length > 0 && (
          <dl class="meta-row">
            {glance.map(g => (
              <div><dt class="mono">{g.label}</dt><dd>{g.value}</dd></div>
            ))}
          </dl>
        )}
      </div>
    </header>

    {d.story && (
      <section class="container story-wrap" aria-label="Problem, decision, result">
        <ol class="story-strip" data-reveal>
          {[['Problem', d.story.problem], ['Decision', d.story.decision], ['Result', d.story.result]].map(([label, text], i) => (
            <li class:list={['story-step', { 'story-result': i === 2 }]}>
              <p class="mono story-label"><span>0{i + 1}</span>{label}</p>
              <p class="story-text">{text}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {d.gallery && d.gallery.length > 0 && (
      <section class="showcase container" aria-label="Product screens">
        <div class="showcase-panel" data-reveal>
          {d.gallery.map((g, i) => (
            <figure class:list={['showcase-item', `frame-${g.frame}`]} style={`--i:${i}`}>
              <div class="showcase-device">
                {g.kind === 'video' ? (
                  <video autoplay muted loop playsinline preload="metadata" poster={g.poster} aria-label={g.alt} data-autopause>
                    <source src={`${g.src}.webm`} type="video/webm" />
                    <source src={`${g.src}.mp4`} type="video/mp4" />
                  </video>
                ) : (
                  <img src={g.src} alt={g.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                )}
              </div>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {d.story && (
      <section class="skim container" aria-label="The short version">

        {d.stats && (
          <dl class="stat-row" data-reveal>
            {d.stats.map(st => (
              <div class="stat-cell"><dt>{st.label}</dt><dd>{st.value}</dd></div>
            ))}
          </dl>
        )}

        {d.decisions && (
          <div class="decisions">
            <h2 class="skim-heading">The hard calls</h2>
            <div class="decision-grid">
              {d.decisions.map((c, i) => (
                <article class="decision-card" data-reveal>
                  <p class="mono decision-num">Call {String(i + 1).padStart(2, '0')}</p>
                  <h3>{c.title}</h3>
                  <dl class="decision-lines">
                    <div><dt class="mono">Problem</dt><dd>{c.problem}</dd></div>
                    <div><dt class="mono">Decision</dt><dd>{c.decision}</dd></div>
                    <div class="decision-res"><dt class="mono">Result</dt><dd>{c.result}</dd></div>
                  </dl>
                  {c.lesson && <p class="decision-lesson">{c.lesson}</p>}
                </article>
              ))}
            </div>
          </div>
        )}

        {d.now && (
          <div class="now-block" data-reveal>
            <h2 class="skim-heading">What I'm on now</h2>
            <ul class="now-list">
              {d.now.map(n => (
                <li><strong>{n.title}</strong><span>{n.body}</span></li>
              ))}
            </ul>
          </div>
        )}

        {d.lesson && (
          <blockquote class="skim-lesson" data-reveal>
            <p class="mono">What I'd take anywhere</p>
            <p class="skim-lesson-text">{d.lesson}</p>
          </blockquote>
        )}
      </section>
    )}

    {!d.story && (glance.length > 0 || d.tldr) && (
      <section class="glance content-width" aria-label="At a glance">
        <div class="glance-card">
          {glance.length > 0 && (
            <dl class="glance-grid">
              {glance.map(g => (
                <div>
                  <dt class="mono">{g.label}</dt>
                  <dd>{g.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {d.tldr && (
            <div class="glance-tldr">
              <p class="mono glance-heading">The short version</p>
              <ul>
                {d.tldr.map(line => <li>{line}</li>)}
              </ul>
            </div>
          )}

          {d.outcome && (
            <div class="glance-outcome">
              <p class="mono glance-heading">Outcome</p>
              <p>{d.outcome}</p>
            </div>
          )}

          {(d.methods || d.tags) && (
            <div class="glance-tags">
              {(d.methods ?? []).concat(d.tags ?? []).map(t => <span class="tag">{t}</span>)}
            </div>
          )}
        </div>
      </section>
    )}

    {d.story ? (
      <details class="full-story content-width" id="full-story">
        <summary>
          <span class="full-story-label">
            <span class="mono">The full story{d.fullStoryTime && ` · ${d.fullStoryTime}`}</span>
            <span class="full-story-title">Every decision, in detail</span>
          </span>
          <span class="full-story-icon" aria-hidden="true">+</span>
        </summary>
        <div class="case-body">
          <Content />
        </div>
      </details>
    ) : (
      <div class="case-body content-width">
        <Content />
      </div>
    )}

    <div class="case-end content-width">
      <div class="case-end-nav">
        {prevStudy && (
          <a href={`/case-studies/${prevStudy.id}`} class="case-nav-link">
            <span class="mono case-nav-label">← Previous</span>
            <span class="case-nav-title">{prevStudy.data.title}</span>
          </a>
        )}
        {nextStudy && nextStudy.id !== study.id && (
          <a href={`/case-studies/${nextStudy.id}`} class="case-nav-link case-nav-next">
            <span class="mono case-nav-label">{currentIndex + 1 === allStudies.length ? 'Back to the first →' : 'Next →'}</span>
            <span class="case-nav-title">{nextStudy.data.title}</span>
          </a>
        )}
      </div>
      <div class="case-end-cta">
        <p>Want to dig into the decisions behind this?</p>
        <div class="case-end-actions">
          <a href="/contact" class="btn">Get in touch →</a>
          <a href="/#work" class="btn btn-outline">All work</a>
        </div>
      </div>
    </div>

  </article>
</Layout>

<style>
  /* ── Showcase (product screens) ── */
  .showcase { padding-top: 0.5rem; padding-bottom: 2.5rem; }
  .showcase-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 5vw, 4rem) clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-surface);
    border-radius: 24px;
    overflow: hidden;
  }
  .showcase-item { margin: 0; display: flex; flex-direction: column; align-items: center; }
  .showcase-item:nth-child(2) { transform: translateY(-0.75rem); }
  .showcase-device {
    width: 100%;
    max-width: 270px;
    transition: transform 0.6s var(--ease-out);
  }
  .showcase-item:hover .showcase-device { transform: translateY(-6px); }
  .showcase-device img, .showcase-device video { display: block; width: 100%; height: auto; }
  .frame-framed video { border-radius: 13% / 6.1%; }
  .frame-screen .showcase-device {
    /* Draw a phone frame around a bare screenshot so all three match. */
    padding: 2.4%;
    background: #1d1e22;
    border-radius: 14% / 6.8%;
    box-shadow: inset 0 0 0 2px #4a4b52, 0 0 0 1px rgba(0,0,0,0.08);
  }
  .frame-screen img { border-radius: 11.5% / 5.6%; }
  .showcase-item figcaption {
    margin-top: 1rem;
    max-width: 30ch;
    text-align: center;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  @media (max-width: 760px) {
    .showcase-panel {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding: 1.75rem 1.25rem 1.25rem;
      scrollbar-width: none;
    }
    .showcase-panel::-webkit-scrollbar { display: none; }
    .showcase-item { flex: 0 0 62%; scroll-snap-align: center; }
    .showcase-item:nth-child(2) { transform: none; }
  }


  /* ── Scannable format ── */
  .meta-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, auto));
    gap: 0.9rem 2rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .meta-row dt { color: var(--color-text-muted); margin-bottom: 0.2rem; }
  .meta-row dd { font-size: 0.9rem; line-height: 1.4; }

  .story-wrap { padding-bottom: 2.5rem; }
  .skim { display: flex; flex-direction: column; gap: clamp(2.5rem, 6vw, 4rem); padding-bottom: 3rem; }

  .story-strip {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .story-step {
    position: relative;
    padding: 1.6rem 1.5rem 1.7rem;
    background: var(--color-surface);
    border-radius: 18px;
  }
  .story-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -0.75rem;
    top: 50%;
    transform: translate(50%, -50%);
    width: 1.9rem; height: 1.9rem;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    z-index: 1;
  }
  .story-label { display: flex; gap: 0.6rem; align-items: baseline; color: var(--color-text-muted); margin-bottom: 0.8rem; }
  .story-label span { color: var(--color-accent); }
  .story-text { font-size: 1.08rem; line-height: 1.5; font-weight: 500; letter-spacing: -0.015em; }
  .story-result { background: var(--color-accent); color: var(--color-on-accent); }
  .story-result .story-label, .story-result .story-label span { color: rgba(255,255,255,0.75); }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .stat-cell { display: flex; flex-direction: column; gap: 0.45rem; padding: 1.5rem 1.25rem 1.5rem 0; }
  .stat-cell dd { order: -1; }
  .stat-cell + .stat-cell { padding-left: 1.25rem; border-left: 1px solid var(--color-border); }
  .stat-cell dd { font-size: clamp(1.9rem, 3.4vw, 2.6rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1; white-space: nowrap; }
  .stat-cell dt { font-size: 0.88rem; line-height: 1.4; color: var(--color-text-secondary); }

  .skim-heading { font-size: 1.5rem; letter-spacing: -0.03em; margin-bottom: 1.25rem; }

  .decision-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .decision-card {
    display: flex; flex-direction: column;
    padding: 1.6rem 1.6rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--color-paper);
    transition: border-color 0.25s, transform 0.5s var(--ease-out);
  }
  .decision-card:hover { border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border)); transform: translateY(-3px); }
  .decision-num { color: var(--color-accent); margin-bottom: 0.4rem; }
  .decision-card h3 { font-size: 1.25rem; letter-spacing: -0.025em; margin-bottom: 1.1rem; }
  .decision-lines { display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .decision-lines div { display: grid; grid-template-columns: 5.6rem 1fr; gap: 0.75rem; align-items: baseline; }
  .decision-lines dt { color: var(--color-text-muted); }
  .decision-lines dd { font-size: 0.95rem; line-height: 1.5; color: var(--color-text-secondary); }
  .decision-res dt { color: var(--color-accent); }
  .decision-res dd { color: var(--color-text); font-weight: 500; }
  .decision-lesson {
    margin-top: 1.2rem; padding-top: 0.9rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.9rem; line-height: 1.45; font-style: italic; color: var(--color-text-secondary);
  }

  .now-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .now-list li { display: flex; flex-direction: column; gap: 0.4rem; padding-top: 0.9rem; border-top: 2px solid var(--color-text); }
  .now-list strong { font-weight: 600; letter-spacing: -0.015em; }
  .now-list span { font-size: 0.93rem; line-height: 1.5; color: var(--color-text-secondary); }

  .skim-lesson { margin: 0; text-align: center; padding: 1rem 0; }
  .skim-lesson .mono { color: var(--color-text-muted); margin-bottom: 0.7rem; }
  .skim-lesson-text { font-size: clamp(1.6rem, 3.6vw, 2.4rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.15; max-width: 22ch; margin: 0 auto; }

  .full-story { margin-bottom: 3.5rem; }
  .full-story summary {
    list-style: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.4rem 1.6rem;
    border-radius: 18px;
    background: var(--color-surface);
    transition: background 0.2s;
  }
  .full-story summary::-webkit-details-marker { display: none; }
  .full-story summary:hover { background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface)); }
  .full-story-label { display: flex; flex-direction: column; gap: 0.25rem; }
  .full-story-label .mono { color: var(--color-accent); }
  .full-story-title { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.025em; }
  .full-story-icon {
    width: 2.2rem; height: 2.2rem; flex-shrink: 0;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--color-text); color: var(--color-paper);
    font-size: 1.3rem; line-height: 1;
    transition: transform 0.3s var(--ease-out);
  }
  .full-story[open] .full-story-icon { transform: rotate(45deg); }
  .full-story .case-body { padding-top: 2.5rem; padding-bottom: 1rem; }

  @media (max-width: 860px) {
    .story-strip { grid-template-columns: 1fr; }
    .story-step:not(:last-child)::after { right: 50%; top: auto; bottom: -0.75rem; transform: translate(50%, 50%) rotate(90deg); }
    .stat-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat-row .stat-cell:nth-child(odd) { padding-left: 0; border-left: none; }
    .stat-row .stat-cell:nth-child(even) { padding-left: 1.25rem; border-left: 1px solid var(--color-border); }
    .stat-row .stat-cell:nth-child(n+3) { border-top: 1px solid var(--color-border); }
    .decision-grid, .now-list { grid-template-columns: 1fr; }
    .meta-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .decision-lines div { grid-template-columns: 1fr; gap: 0.2rem; }
  }

  .case-mascot {
    width: 44px;
    height: auto;
    margin: -0.6rem 0.15rem -0.6rem -0.35rem;
  }

  #reading-progress {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 99;
    pointer-events: none;
  }

  /* ── Header ── */
  .case-header { padding: 3.5rem 0 2.5rem; }

  .back-link {
    display: inline-block;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
  }

  .back-link:hover { color: var(--color-accent); }

  .case-kicker { margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem; }
  .case-read { color: var(--color-text-muted); }

  .case-header h1 {
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    margin-bottom: 1.25rem;
  }

  .case-sub {
    color: var(--color-text-secondary);
    margin: -0.25rem 0 1.25rem;
  }

  .case-excerpt {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ── At a glance ── */
  .glance { margin-bottom: 1rem; }

  .glance-card {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .glance-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 2rem;
  }

  .glance-grid dt { color: var(--color-text-muted); margin-bottom: 0.15rem; }
  .glance-grid dd { font-size: 0.95rem; line-height: 1.45; }

  .glance-heading { color: var(--color-accent); margin-bottom: 0.5rem; }

  .glance-tldr,
  .glance-outcome {
    padding-top: 1.25rem;
    border-top: 1px dashed var(--color-border);
  }

  .glance-tldr ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .glance-tldr li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .glance-tldr li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .glance-outcome p:last-child {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .glance-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  /* ── Prose ── */
  .case-body { padding-top: 3rem; padding-bottom: 4rem; }

  .case-body :global(h2) {
    font-size: 1.7rem;
    margin: 3.25rem 0 1.1rem;
  }

  .case-body :global(h2:first-child) { margin-top: 0; }

  .case-body :global(p) {
    margin-bottom: 1.4rem;
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .case-body :global(strong) { font-weight: 600; }

  .case-body :global(em) { font-style: italic; }

  .case-body :global(ul),
  .case-body :global(ol) {
    padding-left: 1.375rem;
    margin-bottom: 1.4rem;
  }

  .case-body :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.75;
    font-size: 1.0625rem;
  }

  .case-body :global(li::marker) { color: var(--color-accent); }

  .case-body :global(blockquote) {
    margin: 2.5rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 3px solid var(--color-accent);
  }

  .case-body :global(blockquote p) {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.45;
  }

  .case-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* ── End ── */
  .case-end {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .case-end-nav {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .case-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: 320px;
  }

  .case-nav-next { text-align: right; margin-left: auto; }

  .case-nav-label { color: var(--color-text-muted); }

  .case-nav-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
    transition: color 0.15s;
  }

  .case-nav-link:hover .case-nav-title { color: var(--color-accent); }

  .case-end-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.75rem 2rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .case-end-cta p {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .case-end-actions { display: flex; gap: 0.75rem; flex-shrink: 0; }

  @media (max-width: 600px) {
    .glance-card { padding: 1.25rem; }
    .glance-grid { grid-template-columns: 1fr; }
    .case-end-nav { flex-direction: column; }
    .case-nav-next { text-align: left; margin-left: 0; }
    .case-end-cta { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
    .case-end-actions { flex-wrap: wrap; }
  }
</style>

<script>
  function initProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;
    const update = () => {
      const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
      bar.style.transform = `scaleX(${Math.min(scrollTop / (scrollHeight - clientHeight), 1)})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
  initProgress();
  document.addEventListener('astro:page-load', initProgress);
</script>
