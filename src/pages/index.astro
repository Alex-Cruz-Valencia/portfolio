---
import { existsSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// Typographic dashes only: hyphens on the page (design skill rule).
const plain = (text: string) => text.replaceAll(' — ', ' - ').replaceAll(' – ', ' - ').replaceAll('–', '-');

// Optional portrait: drop a file at public/alex.jpg and the hero picks it up.
const portrait = existsSync('public/alex.jpg') ? '/alex.jpg' : null;
---

<Layout
  title="Home"
  description="Alex Cruz-Valencia, CS and Human-Centered Design at Dartmouth. Product management case studies in user research, prioritization, and design leadership."
>

  <!-- Hero -->
  <section class:list={['hero', { 'has-portrait': portrait }]}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow reveal" style="--i: 0">Product Management at Dartmouth</p>
        <h1 class="reveal" style="--i: 1">Product decisions, made from both sides.</h1>
        <p class="hero-sub reveal" style="--i: 2">
          CS major and Human-Centered Design minor at Dartmouth. I lead Evergreen's design,
          run user research, and prioritize at EchoStar.
        </p>
        {studies.length > 0 && (
          <div class="reveal" style="--i: 3">
            <a href="#work" class="btn">See my work</a>
          </div>
        )}
      </div>
      {portrait && (
        <img
          class="hero-portrait reveal"
          style="--i: 2"
          src={portrait}
          alt="Alex Cruz-Valencia"
          width="640"
          height="800"
          fetchpriority="high"
        />
      )}
    </div>
  </section>

  <!-- Proof: figures taken from the case studies below -->
  <section class="proof" aria-label="Results at a glance">
    <div class="container">
      <dl class="proof-row">
        <div class="proof-item scroll-in">
          <dt>students interviewed about where they live</dt>
          <dd>41</dd>
        </div>
        <div class="proof-item scroll-in">
          <dt>designers led on Evergreen</dt>
          <dd>6</dd>
        </div>
        <div class="proof-item scroll-in">
          <dt>BiteBuddy testers who said it would improve their habits</dt>
          <dd>10<span>of 12</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Case Studies: featured + supporting tiles on a 6-column grid -->
  <section class="work" id="work" aria-labelledby="work-title">
    <div class="container">
      <h2 id="work-title" class="section-title">Case studies</h2>
      <div class="study-grid" role="list">
        {studies.map(study => (
          <a
            href={`/case-studies/${study.id}`}
            class="study-card scroll-in"
            role="listitem"
          >
            <p class="study-meta">
              <span>{plain(study.data.date)}</span>
              {study.data.readTime && <span>{study.data.readTime}</span>}
            </p>
            <h3 class="study-title">{plain(study.data.title)}</h3>
            <p class="study-excerpt">{plain(study.data.excerpt)}</p>
            {study.data.tags && study.data.tags.length > 0 && (
              <div class="study-tags" aria-hidden="true">
                {study.data.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            )}
            <span class="study-cta" aria-hidden="true">Read case study →</span>
          </a>
        ))}
      </div>

      {studies.length === 0 && (
        <p class="empty-state">Case studies coming soon.</p>
      )}
    </div>
  </section>

  <!-- Projects -->
  {projects.length > 0 && (
    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <h2 id="projects-title" class="section-title">More work</h2>
        <ul class="project-list" role="list">
          {projects.map(p => (
            <li class="project-item scroll-in">
              <div class="project-head">
                <h3 class="project-title">{p.data.title}</h3>
                {p.data.status && <span class="project-status">{p.data.status}</span>}
              </div>
              <p class="project-role">
                {[p.data.role, p.data.org, p.data.timeframe].filter(Boolean).map(plain).join(', ')}
              </p>
              <p class="project-blurb">{plain(p.data.blurb)}</p>
              {p.data.link && (
                <a
                  class="project-link"
                  href={p.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.data.linkLabel ?? p.data.link} ↗
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

</Layout>

<style>
  /* Motion: CSS only, transform + opacity, gated for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    /* Hierarchy: hero content arrives in reading order. */
    .reveal {
      animation: rise 0.8s var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * 90ms);
    }

    /* Storytelling: sections reveal as they enter the viewport. */
    @supports (animation-timeline: view()) {
      .scroll-in {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 35%;
      }
    }

    @keyframes rise {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

  /* ── Hero ── */
  .hero {
    padding: 5rem 0 4.5rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: end;
  }

  .has-portrait .hero-inner {
    grid-template-columns: 1.5fr 1fr;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
    max-width: 20ch;
    text-wrap: balance;
    margin: 1.25rem 0 1.5rem;
  }

  .hero-sub {
    color: var(--color-text-secondary);
    font-size: 1.1875rem;
    max-width: 44ch;
    margin-bottom: 2.25rem;
  }

  .hero-portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    justify-self: end;
    max-width: 380px;
  }

  /* ── Proof ── */
  .proof {
    padding: 0 0 5rem;
  }

  .proof-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.4fr;
    gap: 2.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .proof-item dd {
    order: -1;
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-text);
  }

  .proof-item dd span {
    font-size: 0.35em;
    letter-spacing: -0.01em;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-left: 0.4em;
  }

  .proof-item dt {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    max-width: 26ch;
    line-height: 1.45;
  }

  /* ── Sections ── */
  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
    margin-bottom: 2.5rem;
  }

  .work {
    padding: 2rem 0 3rem;
    scroll-margin-top: var(--nav-height);
  }

  /* 6-col grid: rows alternate 4+2 / 2+4, so no tile is ever left empty. */
  .study-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  .study-card {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: inherit;
    transition: transform 0.3s var(--ease-out), border-color 0.2s;
  }

  .study-card:nth-child(4n + 1),
  .study-card:nth-child(4n + 4) { grid-column: span 4; }
  .study-card:nth-child(4n + 2),
  .study-card:nth-child(4n + 3) { grid-column: span 2; }

  /* Tint variety across tiles (same accent, locked palette). */
  .study-card:nth-child(4n + 1) {
    background: var(--color-accent-light);
    border-color: transparent;
  }

  .study-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .study-card:active { transform: scale(0.99); }

  .study-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .study-title {
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.875rem;
    text-wrap: balance;
  }

  .study-card:nth-child(4n + 1) .study-title,
  .study-card:nth-child(4n + 4) .study-title {
    font-size: clamp(1.625rem, 3vw, 2.5rem);
  }

  .study-excerpt {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .study-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .study-cta {
    margin-top: auto;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .empty-state {
    color: var(--color-text-secondary);
    padding: 3rem 0;
  }

  /* ── Projects: 2-column grid, no hairline under every row ── */
  .projects {
    padding: 4rem 0 2rem;
    scroll-margin-top: var(--nav-height);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 4rem;
    list-style: none;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .project-title {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }

  .project-status {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.2em 0.75em;
    border-radius: 9999px;
  }

  .project-role {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 0.875rem;
  }

  .project-blurb {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Mobile: every multi-column layout collapses to one column. */
  @media (max-width: 767px) {
    .hero { padding: 3rem 0 3rem; }
    .has-portrait .hero-inner,
    .proof-row,
    .project-list { grid-template-columns: 1fr; }
    .proof-row { gap: 2rem; }
    .study-grid { grid-template-columns: 1fr; }
    .study-card,
    .study-card:nth-child(n) { grid-column: auto; padding: 1.5rem; }
    .hero-portrait { justify-self: start; }
  }
</style>
