---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<Layout
  title="Home"
  description="Alex Cruz-Valencia — CS + Human-Centered Design at Dartmouth. Product management case studies in user research, prioritization, and design leadership."
>

  <!-- Hero -->
  <section class="hero">
    <div class="content-width">
      <p class="eyebrow">Product Management · Dartmouth</p>
      <h1>Product decisions,<br />made from both sides.</h1>
      <p class="hero-sub">
        I'm Alex — a Computer Science major and Human-Centered Design minor at Dartmouth.
        I've led a 6-person design team on an AI wellness app tested by ~200 students,
        run research across 15 residential communities, and made prioritization calls
        inside a product team at EchoStar. I care about the whole loop: finding the real
        user pain, shaping the experience, choosing what to build under real constraints,
        and checking whether it worked.
      </p>
      {studies.length > 0 && (
        <a href="#work" class="btn">
          See my work →
        </a>
      )}
    </div>
  </section>

  <hr />

  <!-- Case Studies -->
  <section class="work" id="work" aria-label="Case studies">
    <div class="content-width">
      <p class="eyebrow section-eyebrow">Case Studies</p>
      <div class="study-list" role="list">
        {studies.map(study => (
          <a
            href={`/case-studies/${study.id}`}
            class="study-link"
            role="listitem"
            aria-label={`Read case study: ${study.data.title}`}
          >
            <div class="study-meta" aria-hidden="true">
              <span>{study.data.date}</span>
              {study.data.readTime && <span>{study.data.readTime}</span>}
            </div>
            <h2 class="study-title">{study.data.title}</h2>
            <p class="study-excerpt">{study.data.excerpt}</p>
            {study.data.tags && study.data.tags.length > 0 && (
              <div class="study-tags" aria-hidden="true">
                {study.data.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            )}
            <span class="study-cta" aria-hidden="true">Read case study →</span>
          </a>
        ))}
      </div>

      {studies.length === 0 && (
        <p class="empty-state">Case studies coming soon.</p>
      )}
    </div>
  </section>

  <!-- Projects -->
  {projects.length > 0 && (
    <section class="projects" id="projects" aria-label="More work">
      <div class="content-width">
        <p class="eyebrow section-eyebrow">More Work</p>
        <ul class="project-list" role="list">
          {projects.map(p => (
            <li class="project-item">
              <div class="project-head">
                <h3 class="project-title">{p.data.title}</h3>
                {p.data.status && <span class="project-status">{p.data.status}</span>}
              </div>
              <p class="project-role">
                {p.data.role}{p.data.org ? ` · ${p.data.org}` : ''} · {p.data.timeframe}
              </p>
              <p class="project-blurb">{p.data.blurb}</p>
              {p.data.link && (
                <a
                  class="project-link"
                  href={p.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.data.linkLabel ?? p.data.link} ↗
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 7rem 0 6rem;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 1rem 0 1.5rem;
    line-height: 1.08;
  }

  .hero-sub {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  /* ── Work Section ── */
  .work {
    padding: 4.5rem 0 2rem;
    scroll-margin-top: var(--nav-height);
  }

  .section-eyebrow {
    margin-bottom: 2.5rem;
  }

  .study-list {
    display: flex;
    flex-direction: column;
  }

  .study-link {
    display: block;
    padding: 2.75rem 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    position: relative;
    transition: padding-left 0.2s var(--ease-out);
  }

  .study-link:first-of-type {
    border-top: 1px solid var(--color-border);
  }

  .study-link::before {
    content: '';
    position: absolute;
    left: -2rem;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent);
    border-radius: 0 2px 2px 0;
    transform: scaleY(0);
    transition: transform 0.2s var(--ease-out);
    transform-origin: center;
  }

  .study-link:hover::before {
    transform: scaleY(1);
  }

  .study-link:hover .study-title {
    color: var(--color-accent);
  }

  .study-link:hover .study-cta {
    letter-spacing: 0.03em;
  }

  .study-meta {
    display: flex;
    gap: 0;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    margin-bottom: 0.875rem;
    letter-spacing: 0.01em;
  }

  .study-meta span + span::before {
    content: '·';
    margin: 0 0.75rem;
  }

  .study-title {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 0.875rem;
    transition: color 0.15s;
    line-height: 1.2;
  }

  .study-excerpt {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 580px;
    margin-bottom: 1.25rem;
  }

  .study-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .study-cta {
    display: inline-flex;
    gap: 0.35em;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: letter-spacing 0.2s var(--ease-out);
  }

  .empty-state {
    color: var(--color-text-secondary);
    padding: 3rem 0;
  }

  /* ── Projects Section ── */
  .projects {
    padding: 4rem 0 2rem;
    scroll-margin-top: var(--nav-height);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    list-style: none;
  }

  .project-item {
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .project-head {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .project-title {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .project-status {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.2em 0.7em;
    border-radius: 9999px;
  }

  .project-role {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
    margin-bottom: 0.875rem;
  }

  .project-blurb {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 580px;
    margin-bottom: 1rem;
  }

  .project-link {
    display: inline-flex;
    gap: 0.35em;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 4.5rem 0 4rem;
    }

    .study-link::before {
      left: -1.25rem;
    }
  }
</style>
