---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { plain, portraitSrc, resumeHref } from '../lib/site';
import { testimonials } from '../data/testimonials';
import LogoStrip from '../components/LogoStrip.astro';

const studies = (await getCollection('caseStudies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const featured = studies.find(s => s.data.featured) ?? studies[0];
const rest = studies.filter(s => s.id !== featured?.id);

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const majorProjects = projects.filter(p => !p.data.minor);
// Each project's markdown body becomes its expandable "Read more" write-up.
const projectBodies = Object.fromEntries(
  await Promise.all(projects.map(async p => [p.id, p.body?.trim() ? (await render(p)).Content : null]))
);
const minorProjects = projects.filter(p => p.data.minor);

const proof = [
  { value: '$5M', count: { to: 5, prefix: '$', suffix: 'M' }, label: 'in research funding behind Evergreen' },
  { value: '200', count: { to: 200 }, label: 'students testing Evergreen, up from 15' },
  { value: '41', count: { to: 41 }, label: 'student voices, cited in Dartmouth\'s official report' },
  { value: '8 → 2', count: { from: 8, to: 2, prefix: '8 → ' }, label: 'upfront permissions, once real users weighed in' },
];


---

<Layout title="Home">

  <!-- Hero -->
  <section class:list={['hero', { 'has-portrait': portraitSrc, 'has-stack': !portraitSrc }]}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="status-pill reveal" style="--i: 0">Dartmouth '28 · Open to Summer 2027 APM / PM internships</p>
        <h1 class="hero-title" aria-label="I make the case. Users make the call.">
          {['I', 'make', 'the', 'case.'].map((w, i) => (
            <Fragment><span class="w" aria-hidden="true"><span style={`--w:${i}`}>{w}</span></span>{' '}</Fragment>
          ))}<br aria-hidden="true" />{['Users', 'make', 'the'].map((w, i) => (
            <Fragment><span class="w" aria-hidden="true"><span style={`--w:${i + 4}`}>{w}</span></span>{' '}</Fragment>
          ))}<span class="w" aria-hidden="true"><span style="--w:7"><em>call</em>.</span></span>
        </h1>
        <p class="hero-sub reveal" style="--i: 2">
          I'm Alex, the PM on{' '}
          <a href="/case-studies/evergreen-design-leadership">Evergreen</a>, Dartmouth's AI wellness app,
          now in testing with 200 students. Before that: product at EchoStar and Youphoria.
          I study CS and Human-Centered Design at Dartmouth.
        </p>
        <div class="hero-ctas reveal" style="--i: 3">
          <a href="#work" class="btn">Read the case studies</a>
          {resumeHref
            ? <a href={resumeHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">Résumé (PDF)</a>
            : <a href="/contact" class="btn btn-outline">Get in touch</a>}
        </div>
      </div>
      {!portraitSrc && (
        <div class="hero-stack" aria-label="A peek at the work">
          <a href="/case-studies/design-corps-llc-research" class="stack-item stack-doc" style="--d:0.35;--r:-7deg;--n:0" aria-label="Design Corps case study">
            <img src="/work/design-corps/report-cover.webp" alt="" width="564" height="459" />
          </a>
          <a href="/case-studies/echostar-dashboard" class="stack-item stack-dash" style="--d:0.6;--r:4deg;--n:1" aria-label="EchoStar case study">
            <span class="stack-bar" aria-hidden="true"></span>
            <img src="/work/echostar/card-preview.webp" alt="" width="1000" height="683" />
          </a>
          <a href="/case-studies/evergreen-design-leadership" class="stack-item stack-phone" style="--d:1;--r:-3deg;--n:2" aria-label="Evergreen case study">
            <img src="/work/evergreen/evie-chat.webp" alt="" width="640" height="1333" />
          </a>
        </div>
      )}
      {portraitSrc && (
        <figure class="hero-portrait reveal" style="--i: 2">
          <img src={portraitSrc} alt="Alex Cruz-Valencia" width="560" height="700" fetchpriority="high" />
        </figure>
      )}
    </div>
  </section>

  <!-- Proof -->
  <section class="proof" aria-label="Results at a glance">
    <div class="container">
      <dl class="proof-row">
        {proof.map(p => (
          <div class="proof-item scroll-in">
            <dd
              data-count-to={p.count?.to}
              data-count-from={p.count?.from}
              data-prefix={p.count?.prefix}
              data-suffix={p.count?.suffix}
            >{p.value}</dd>
            <dt>{p.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <LogoStrip />

  <!-- Case studies -->
  <section class="work" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-label">
        <h2 id="work-title">Case studies</h2>
        <span class="mono">{studies.length} case studies · about a minute each</span>
      </div>

      {featured && (
        <a href={`/case-studies/${featured.id}`} class="featured scroll-in">
          <div class="featured-copy">
            <p class="mono card-meta">
              <span class="card-org">{featured.data.org?.split(/ · |, /)[0]}</span>
              <span>{plain(featured.data.date)}</span>
            </p>
            <h3 transition:name={`title-${featured.id}`}>{plain(featured.data.title)}</h3>
            <p class="card-excerpt card-deck">{plain(featured.data.deck ?? featured.data.excerpt)}</p>
            <span class="card-cta">Read the case study →</span>
          </div>
          {featured.data.highlights && (
            <dl class="featured-side highlight-row highlight-lg">
              {featured.data.highlights.map(h => (
                <div><dd>{h.value}</dd><dt>{h.label}</dt></div>
              ))}
            </dl>
          )}
          {featured.data.cardImage && (
            <div class="featured-visual" aria-hidden="true">
              <img src={featured.data.cardImage} alt="" width="640" height="1333" loading="lazy" decoding="async" />
            </div>
          )}
        </a>
      )}

      <div class="study-grid" role="list">
        {rest.map(study => (
          <a href={`/case-studies/${study.id}`} class:list={['study-card scroll-in', { 'has-visual': study.data.cardImage }]} role="listitem">
            <p class="mono card-meta">
              <span class="card-org">{study.data.org?.split(/ · |, /)[0]}</span>
              <span>{plain(study.data.date)}</span>
            </p>
            <h3 transition:name={`title-${study.id}`}>{plain(study.data.title)}</h3>
            <p class="card-excerpt card-deck">{plain(study.data.deck ?? study.data.excerpt)}</p>
            {study.data.highlights && (
              <dl class="highlight-row highlight-md">
                {study.data.highlights.map(h => <div><dd>{h.value}</dd><dt>{h.label}</dt></div>)}
              </dl>
            )}
            <span class="card-cta">Read →</span>
            {study.data.cardImage && (
              <div class:list={['card-visual', `card-visual-${study.data.cardFrame}`]} aria-hidden="true">
                <img src={study.data.cardImage} alt="" loading="lazy" decoding="async" />
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials (hidden until data/testimonials.ts has entries) -->
  {testimonials.length > 0 && (
    <section class="voices band" aria-labelledby="voices-title">
      <div class="container">
        <h2 id="voices-title" class="sr-only">From people I've worked with</h2>
        {testimonials.map(t => (
          <figure class="pull-quote scroll-in">
            <span class="pull-mark" aria-hidden="true">“</span>
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.title}</span>
              {t.relation && <span class="mono">{t.relation}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- More work -->
  {projects.length > 0 && (
    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-label">
          <h2 id="projects-title">More work</h2>
          <span class="mono">Shipped, building, and testing</span>
        </div>
        <ul class="proj-grid" role="list">
          {majorProjects.map(p => (
            <li class="proj-card scroll-in" id={`project-${p.id}`}>
              <div class="proj-top">
                <span class="proj-mark" aria-hidden="true">{p.data.title.replace(/^(The |Dartmouth )/, '').slice(0, 1)}</span>
                {p.data.status && <span class="proj-status mono">{p.data.status}</span>}
              </div>
              <h3 class="proj-title">{p.data.title}</h3>
              <p class="mono proj-role">{[p.data.role, p.data.timeframe].filter(Boolean).map(plain).join(' · ')}</p>
              <p class="proj-summary">{p.data.summary ?? p.data.blurb}</p>
              {(() => { const Body = projectBodies[p.id]; return (
                <details class="project-more">
                  <summary class="mono">Read more</summary>
                  {Body ? <div class="project-body"><Body /></div> : <p class="project-blurb">{plain(p.data.blurb)}</p>}
                </details>
              ); })()}
              {p.data.link && (
                <a class="project-link" href={p.data.link} target="_blank" rel="noopener noreferrer">
                  {p.data.linkLabel ?? p.data.link} ↗
                </a>
              )}
            </li>
          ))}
        </ul>
        {minorProjects.length > 0 && (
          <div class="also">
            <p class="mono also-label">Also</p>
            <ul class="also-list" role="list">
              {minorProjects.map(p => (
                <li id={`project-${p.id}`}>
                  <strong>{p.data.title}</strong>
                  <span class="mono also-meta">{[p.data.role, p.data.timeframe].filter(Boolean).join(' · ')}</span>
                  <span class="also-text">{p.data.summary ?? p.data.blurb}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

</Layout>

<script>
  function initStack() {
    const hero = document.querySelector<HTMLElement>('.has-stack');
    const stack = document.querySelector<HTMLElement>('.hero-stack');
    if (!hero || !stack || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    hero.addEventListener('pointermove', e => {
      const r = hero.getBoundingClientRect();
      stack.style.setProperty('--mx', String(((e.clientX - r.left) / r.width - 0.5) * 2));
      stack.style.setProperty('--my', String(((e.clientY - r.top) / r.height - 0.5) * 2));
    });
    hero.addEventListener('pointerleave', () => { stack.style.setProperty('--mx', '0'); stack.style.setProperty('--my', '0'); });
  }
  initStack();
  document.addEventListener('astro:page-load', initStack);
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      animation: rise 0.8s var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * 90ms);
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: none; }
    }
  }

  section { padding: 4.5rem 0; }

  /* ── Hero ── */
  .hero { padding: 3rem 0 2rem; }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: end;
  }

  .has-portrait .hero-inner { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }

  .hero-copy { max-width: 820px; }

  .hero h1 {
    font-size: clamp(2.3rem, 5.2vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 17ch;
    margin: 1.25rem 0 1.25rem;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 660px;
    margin-bottom: 1.75rem;
  }

  .hero-sub a {
    color: var(--color-text);
    border-bottom: 1px solid var(--color-accent);
  }

  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .hero-portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  /* ── Proof ── */
  .proof { padding: 0 0 2rem; }

  .proof-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem 1.5rem 1.6rem 0;
  }

  .proof-item + .proof-item {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }

  .proof-item dd {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    color: var(--color-accent);
  }

  .proof-item dt {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  /* ── Cards ── */
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .card-org { color: var(--color-accent); }

  .card-sub {
    color: var(--color-text-secondary);
    margin: -0.25rem 0 0.85rem;
    line-height: 1.5;
  }

  .card-excerpt {
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .card-cta {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.25rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    margin-bottom: 1.25rem;
    transition: border-color 0.2s, transform 0.2s var(--ease-out);
  }

  .featured:hover,
  .study-card:hover { border-color: var(--color-text-secondary); transform: translateY(-2px); }

  .featured h3 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    margin-bottom: 1rem;
  }

  .featured-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-left: 2rem;
    border-left: 1px dashed var(--color-border);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .side-label { color: var(--color-text-muted); margin-bottom: 0.2rem; }

  .side-outcome { font-family: var(--font-display); font-size: 1.05rem; }

  .card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; }

  .study-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .study-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: border-color 0.2s, transform 0.2s var(--ease-out);
  }

  .study-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .study-card .card-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-outcome {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .card-outcome .mono {
    display: block;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .study-card .card-cta { margin-top: auto; padding-top: 1.1rem; }


  /* Result chips */
  .card-deck { max-width: 52ch; }
  /* Result numbers: one style everywhere, two sizes */
  /* Result numbers: one grid everywhere. Same column width on every card, so the
     numbers line up straight down the page; Evergreen just uses a bigger size. */
  .highlight-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 1rem;
    width: min(100%, 422px);
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .highlight-row div { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .highlight-row dd { order: -1; font-weight: 500; letter-spacing: -0.035em; line-height: 1; color: var(--color-accent); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .highlight-row dt { font-size: 0.84rem; line-height: 1.3; color: var(--color-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .highlight-md dd { font-size: 1.6rem; }
  .highlight-lg dd { font-size: 1.75rem; }
  @media (max-width: 640px) {
    .highlight-row { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 0.9rem; }
    .highlight-row dt { white-space: normal; font-size: 0.78rem; }
    .highlight-md dd { font-size: 1.35rem; }
    .highlight-lg dd { font-size: 1.6rem; }
  }

  /* ── Testimonials ── */
  .voice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .voice {
    padding: 1.75rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .voice blockquote {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.45;
    margin-bottom: 1.25rem;
  }

  .voice figcaption {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .voice figcaption strong { color: var(--color-text); font-weight: 600; }

  /* ── Projects ── */
  .project-list { list-style: none; }

  .project-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-item:first-child { padding-top: 0; }

  .project-item { scroll-margin-top: calc(var(--nav-height) + 1.5rem); }

  .project-item:target {
    animation: target-flash 2.4s var(--ease-out) both;
    border-radius: var(--radius-card);
  }

  @keyframes target-flash {
    0%, 35% { background: var(--color-accent-light); box-shadow: 0 0 0 1rem var(--color-accent-light); }
    100% { background: transparent; box-shadow: 0 0 0 1rem transparent; }
  }

  .project-title { font-size: 1.4rem; margin-bottom: 0.35rem; }

  .project-role { color: var(--color-text-muted); }

  .project-status {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.15em 0.6em;
    background: var(--color-highlight);
    border-radius: 4px;
    font-size: 0.7rem;
  }

  .project-summary {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .project-more { margin-top: 0.5rem; }

  .project-more summary {
    cursor: pointer;
    color: var(--color-text-muted);
    list-style: none;
    display: inline-flex;
    gap: 0.4rem;
  }

  .project-more summary::-webkit-details-marker { display: none; }
  .project-more summary::before { content: '+'; color: var(--color-accent); }
  .project-more[open] summary::before { content: '−'; }
  .project-more summary:hover { color: var(--color-text); }
  .project-more .project-blurb { margin-top: 0.6rem; }

  .also {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem;
    padding-top: 1.5rem;
  }

  .also-label { color: var(--color-text-muted); }

  .also-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .also-list li { display: flex; flex-direction: column; gap: 0.1rem; }
  .also-list strong { font-weight: 600; }
  .also-meta { color: var(--color-text-muted); }
  .also-text { color: var(--color-text-secondary); }

  .project-blurb {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .project-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
  }


  /* ── Hero stack ── */
  .has-stack .hero-inner { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: center; }
  .hero-stack { position: relative; height: 470px; --mx: 0; --my: 0; }
  .stack-item {
    position: absolute;
    display: block;
    transform: translate3d(calc(var(--mx) * var(--d) * 14px), calc(var(--my) * var(--d) * 10px), 0) rotate(var(--r));
    transition: transform 0.6s var(--ease-out), box-shadow 0.4s;
  }
  .stack-item img { display: block; width: 100%; height: auto; }
  .stack-item:hover { z-index: 5; }
  .stack-doc {
    width: 58%; left: 0; top: 6%;
    background: #fff; border-radius: 10px; overflow: hidden;
    box-shadow: 0 0 0 1px var(--color-border), 0 24px 48px -28px rgba(10, 14, 30, 0.4);
  }
  .stack-dash {
    width: 82%; left: 4%; bottom: 4%;
    border-radius: 12px; overflow: hidden; background: #0e1117;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.08), 0 36px 60px -30px rgba(10, 14, 30, 0.65);
  }
  .stack-bar { display: block; height: 22px; background: #1b1e26 radial-gradient(circle at 14px 11px, #ff5f57 4px, transparent 4.5px), radial-gradient(circle at 30px 11px, #febc2e 4px, transparent 4.5px), radial-gradient(circle at 46px 11px, #28c840 4px, transparent 4.5px); background-color: #1b1e26; }
  .stack-phone { width: 36%; right: 0; top: 0; filter: drop-shadow(0 30px 40px rgba(10, 14, 30, 0.35)); }
