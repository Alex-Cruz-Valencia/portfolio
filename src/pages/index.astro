---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const studies = await getCollection('caseStudies');
---

<Layout title="Home" description="Product management portfolio — case studies in user research, prioritization, and design.">

  <!-- Hero -->
  <section class="hero">
    <div class="content-width">
      <p class="eyebrow">Product Management</p>
      <h1>I build things<br />people actually want.</h1>
      <p class="hero-sub">
        Product-sense-led PM with a background in CS and human-centered design.
        I work the full loop: locating user pain, designing the experience,
        making prioritization calls under constraint, and measuring what changed.
      </p>
      {studies.length > 0 && (
        <a href={`/case-studies/${studies[0].id}`} class="btn">
          Read my work →
        </a>
      )}
    </div>
  </section>

  <hr />

  <!-- Case Studies -->
  <section class="work">
    <div class="content-width">
      <p class="eyebrow section-eyebrow">Work</p>
      <div class="study-list">
        {studies.map(study => (
          <a href={`/case-studies/${study.id}`} class="study-link">
            <div class="study-meta">
              <span>{study.data.date}</span>
              {study.data.readTime && <span>{study.data.readTime}</span>}
            </div>
            <h2 class="study-title">{study.data.title}</h2>
            <p class="study-excerpt">{study.data.excerpt}</p>
            {study.data.tags && study.data.tags.length > 0 && (
              <div class="study-tags">
                {study.data.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            )}
            <span class="study-cta">Read case study →</span>
          </a>
        ))}
      </div>

      {studies.length === 0 && (
        <p class="empty-state">Case studies coming soon.</p>
      )}
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 7rem 0 6rem;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 1rem 0 1.5rem;
    line-height: 1.08;
  }

  .hero-sub {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    max-width: 520px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  /* ── Work Section ── */
  .work {
    padding: 4.5rem 0 2rem;
  }

  .section-eyebrow {
    margin-bottom: 2.5rem;
  }

  .study-list {
    display: flex;
    flex-direction: column;
  }

  .study-link {
    display: block;
    padding: 2.75rem 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    transition: background 0.15s;
  }

  .study-link:first-of-type {
    border-top: 1px solid var(--color-border);
  }

  .study-link:hover .study-title {
    color: var(--color-accent);
  }

  .study-link:hover .study-cta {
    gap: 0.6em;
  }

  .study-meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    margin-bottom: 0.875rem;
    letter-spacing: 0.01em;
  }

  .study-meta span + span::before {
    content: '·';
    margin-right: 1.25rem;
  }

  .study-title {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 0.875rem;
    transition: color 0.15s;
    line-height: 1.2;
  }

  .study-excerpt {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 580px;
    margin-bottom: 1.25rem;
  }

  .study-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .study-cta {
    display: inline-flex;
    gap: 0.35em;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: gap 0.15s;
  }

  .empty-state {
    color: var(--color-text-secondary);
    padding: 3rem 0;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 4.5rem 0 4rem;
    }
  }
</style>
