---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { plain, portraitSrc, resumeHref } from '../lib/site';
import { testimonials } from '../data/testimonials';
import LogoStrip from '../components/LogoStrip.astro';

const studies = (await getCollection('caseStudies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const featured = studies.find(s => s.data.featured) ?? studies[0];
const rest = studies.filter(s => s.id !== featured?.id);

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const majorProjects = projects.filter(p => !p.data.minor);
const minorProjects = projects.filter(p => p.data.minor);

const proof = [
  { value: '$5M', label: 'in Dartmouth research funding behind Evergreen, the AI product I PM' },
  { value: '200', label: 'students in Evergreen\'s current research group, up from 15 at first test' },
  { value: '41', label: 'student voices in research cited in Dartmouth\'s official residential communities report' },
  { value: '8 → 2', label: 'upfront permissions on Evergreen, the ask leadership rejected twice in V1' },
];

const now = [
  {
    where: 'Evergreen',
    what: 'Tool calling for Evie',
    detail: 'Deciding what Evergreen\'s AI can do on a student\'s behalf, which tools come first, and what it should never call on its own.',
  },
  {
    where: 'Evergreen',
    what: 'How Evie remembers',
    detail: 'What it keeps, for how long, what it deliberately forgets, and how a student can see or delete it.',
  },
  {
    where: 'Evergreen',
    what: 'Onboarding friction audit',
    detail: 'Onboarding is where students dropped off. Cut it from 80 questions to 30, split across 4 modules, and still digging into why.',
  },
  {
    where: 'DALI Lab',
    what: 'Mentoring two new PMs',
    detail: 'Coaching first-time PMs on scoping, prioritization, and research, and teaching PM classes.',
  },
];

---

<Layout title="Home">

  <!-- Hero -->
  <section class:list={['hero', { 'has-portrait': portraitSrc }]}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="status-pill reveal" style="--i: 0">Dartmouth '28 · Open to Summer 2027 APM / PM internships</p>
        <h1 class="reveal" style="--i: 1">
          I'd rather <em>learn</em> the answer than win the argument.
        </h1>
        <p class="hero-sub reveal" style="--i: 2">
          I'm Alex Cruz-Valencia, a CS and Human-Centered Design student and the PM for{' '}
          <a href="/case-studies/evergreen-design-leadership">Evergreen</a>, Dartmouth's AI wellness app,
          in testing with 200 students. I lead its design and engineering teams. Before that: product
          at EchoStar and Youphoria.
        </p>
        <div class="hero-ctas reveal" style="--i: 3">
          <a href="#work" class="btn">Read the case studies</a>
          {resumeHref
            ? <a href={resumeHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">Résumé (PDF)</a>
            : <a href="/contact" class="btn btn-outline">Get in touch</a>}
        </div>
      </div>
      {portraitSrc && (
        <figure class="hero-portrait reveal" style="--i: 2">
          <img src={portraitSrc} alt="Alex Cruz-Valencia" width="560" height="700" fetchpriority="high" />
        </figure>
      )}
    </div>
  </section>

  <!-- Proof -->
  <section class="proof" aria-label="Results at a glance">
    <div class="container">
      <dl class="proof-row">
        {proof.map(p => (
          <div class="proof-item scroll-in">
            <dd>{p.value}</dd>
            <dt>{p.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <LogoStrip />

  <!-- Case studies -->
  <section class="work" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-label">
        <h2 id="work-title">Case studies</h2>
        <span class="mono">{studies.length} case studies · each opens with a 30-second summary</span>
      </div>

      {featured && (
        <a href={`/case-studies/${featured.id}`} class="featured scroll-in">
          <div class="featured-copy">
            <p class="mono card-meta">
              <span class="card-org">{featured.data.org?.split(' · ')[0]}</span>
              <span>{plain(featured.data.date)}</span>
              {featured.data.readTime && <span>{featured.data.readTime}</span>}
            </p>
            <h3>{plain(featured.data.title)}</h3>
            {featured.data.subtitle && <p class="mono card-sub">{featured.data.subtitle}</p>}
            <p class="card-excerpt">{plain(featured.data.excerpt)}</p>
            <span class="card-cta">Read the case study →</span>
          </div>
          <div class="featured-side">
            {featured.data.role && (
              <div>
                <p class="mono side-label">Role</p>
                <p>{featured.data.role}</p>
              </div>
            )}
            {featured.data.outcome && (
              <div>
                <p class="mono side-label">Outcome</p>
                <p class="side-outcome">{featured.data.outcome}</p>
              </div>
            )}
            {featured.data.tags && (
              <div class="card-tags" aria-hidden="true">
                {featured.data.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
        </a>
      )}

      <div class="study-grid" role="list">
        {rest.map(study => (
          <a href={`/case-studies/${study.id}`} class="study-card scroll-in" role="listitem">
            <p class="mono card-meta">
              <span class="card-org">{study.data.org?.split(' · ')[0]}</span>
              <span>{plain(study.data.date)}</span>
            </p>
            <h3>{plain(study.data.title)}</h3>
            {study.data.subtitle && <p class="mono card-sub">{study.data.subtitle}</p>}
            <p class="card-excerpt">{plain(study.data.excerpt)}</p>
            {study.data.outcome && (
              <p class="card-outcome"><span class="mono">Outcome</span>{study.data.outcome}</p>
            )}
            <span class="card-cta">Read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials (hidden until data/testimonials.ts has entries) -->
  {testimonials.length > 0 && (
    <section class="voices" aria-labelledby="voices-title">
      <div class="container">
        <div class="section-label">
          <h2 id="voices-title">From people I've worked with</h2>
        </div>
        <div class="voice-grid">
          {testimonials.map(t => (
            <figure class="voice scroll-in">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <strong>{t.name}</strong>
                <span>{t.title}</span>
                {t.relation && <span class="mono">{t.relation}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Now -->
  <section class="now" aria-labelledby="now-title">
    <div class="container">
      <div class="section-label">
        <h2 id="now-title">What I'm working on now</h2>
        <span class="mono">Updated Oct 2026</span>
      </div>
      <ul class="now-list" role="list">
        {now.map(n => (
          <li class="now-item scroll-in">
            <p class="mono now-where">{n.where}</p>
            <h3>{n.what}</h3>
            <p>{n.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- More work -->
  {projects.length > 0 && (
    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-label">
          <h2 id="projects-title">More work</h2>
          <span class="mono">Shipped, building, and testing</span>
        </div>
        <ul class="project-list" role="list">
          {majorProjects.map(p => (
            <li class="project-item scroll-in" id={`project-${p.id}`}>
              <div class="project-left">
                <h3 class="project-title">{p.data.title}</h3>
                <p class="mono project-role">
                  {[p.data.role, p.data.timeframe].filter(Boolean).map(plain).join(' · ')}
                </p>
                {p.data.status && <span class="project-status mono">{p.data.status}</span>}
              </div>
              <div class="project-right">
                <p class="project-summary">{p.data.summary ?? p.data.blurb}</p>
                {p.data.summary && (
                  <details class="project-more">
                    <summary class="mono">More detail</summary>
                    <p class="project-blurb">{plain(p.data.blurb)}</p>
                  </details>
                )}
                {p.data.link && (
                  <a class="project-link" href={p.data.link} target="_blank" rel="noopener noreferrer">
                    {p.data.linkLabel ?? p.data.link} ↗
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
        {minorProjects.length > 0 && (
          <div class="also">
            <p class="mono also-label">Also</p>
            <ul class="also-list" role="list">
              {minorProjects.map(p => (
                <li id={`project-${p.id}`}>
                  <strong>{p.data.title}</strong>
                  <span class="mono also-meta">{[p.data.role, p.data.timeframe].filter(Boolean).join(' · ')}</span>
                  <span class="also-text">{p.data.summary ?? p.data.blurb}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      animation: rise 0.8s var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * 90ms);
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: none; }
    }
    @supports (animation-timeline: view()) {
      .scroll-in {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 35%;
      }
    }
  }

  section { padding: 4.5rem 0; }

  /* ── Hero ── */
  .hero { padding: 3rem 0 2rem; }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: end;
  }

  .has-portrait .hero-inner { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }

  .hero-copy { max-width: 820px; }

  .hero h1 {
    font-size: clamp(2.3rem, 5.2vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 17ch;
    margin: 1.25rem 0 1.25rem;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 660px;
    margin-bottom: 1.75rem;
  }

  .hero-sub a {
    color: var(--color-text);
    border-bottom: 1px solid var(--color-accent);
  }

  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .hero-portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  /* ── Proof ── */
  .proof { padding: 0 0 2rem; }

  .proof-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem 1.5rem 1.6rem 0;
  }

  .proof-item + .proof-item {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }

  .proof-item dd {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    color: var(--color-accent);
  }

  .proof-item dt {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  /* ── Cards ── */
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .card-org { color: var(--color-accent); }

  .card-sub {
    color: var(--color-text-secondary);
    margin: -0.25rem 0 0.85rem;
    line-height: 1.5;
  }

  .card-excerpt {
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .card-cta {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.25rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    margin-bottom: 1.25rem;
    transition: border-color 0.2s, transform 0.2s var(--ease-out);
  }

  .featured:hover,
  .study-card:hover { border-color: var(--color-text-secondary); transform: translateY(-2px); }

  .featured h3 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    margin-bottom: 1rem;
  }

  .featured-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-left: 2rem;
    border-left: 1px dashed var(--color-border);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .side-label { color: var(--color-text-muted); margin-bottom: 0.2rem; }

  .side-outcome { font-family: var(--font-display); font-size: 1.05rem; }

  .card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; }

  .study-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .study-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: border-color 0.2s, transform 0.2s var(--ease-out);
  }

  .study-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .study-card .card-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-outcome {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .card-outcome .mono {
    display: block;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .study-card .card-cta { margin-top: auto; padding-top: 1.1rem; }

  /* ── Now ── */
  .now-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .now-item {
    padding-top: 1rem;
    border-top: 2px solid var(--color-accent);
  }

  .now-where { color: var(--color-accent); margin-bottom: 0.35rem; }

  .now-item h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }

  .now-item p:last-child {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* ── Testimonials ── */
  .voice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .voice {
    padding: 1.75rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .voice blockquote {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.45;
    margin-bottom: 1.25rem;
  }

  .voice figcaption {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .voice figcaption strong { color: var(--color-text); font-weight: 600; }

  /* ── Projects ── */
  .project-list { list-style: none; }

  .project-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-item:first-child { padding-top: 0; }

  .project-item { scroll-margin-top: calc(var(--nav-height) + 1.5rem); }

  .project-item:target {
    animation: target-flash 2.4s var(--ease-out) both;
    border-radius: var(--radius-card);
  }

  @keyframes target-flash {
    0%, 35% { background: var(--color-accent-light); box-shadow: 0 0 0 1rem var(--color-accent-light); }
    100% { background: transparent; box-shadow: 0 0 0 1rem transparent; }
  }

  .project-title { font-size: 1.4rem; margin-bottom: 0.35rem; }

  .project-role { color: var(--color-text-muted); }

  .project-status {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.15em 0.6em;
    background: var(--color-highlight);
    border-radius: 4px;
    font-size: 0.7rem;
  }

  .project-summary {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .project-more { margin-top: 0.5rem; }

  .project-more summary {
    cursor: pointer;
    color: var(--color-text-muted);
    list-style: none;
    display: inline-flex;
    gap: 0.4rem;
  }

  .project-more summary::-webkit-details-marker { display: none; }
  .project-more summary::before { content: '+'; color: var(--color-accent); }
  .project-more[open] summary::before { content: '−'; }
  .project-more summary:hover { color: var(--color-text); }
  .project-more .project-blurb { margin-top: 0.6rem; }

  .also {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem;
    padding-top: 1.5rem;
  }

  .also-label { color: var(--color-text-muted); }

  .also-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .also-list li { display: flex; flex-direction: column; gap: 0.1rem; }
  .also-list strong { font-weight: 600; }
  .also-meta { color: var(--color-text-muted); }
  .also-text { color: var(--color-text-secondary); }

  .project-blurb {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .project-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .proof-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-item, .proof-item + .proof-item { border-left: none; padding-left: 0; }
    .proof-item:nth-child(even) { border-left: 1px solid var(--color-border); padding-left: 1.5rem; }
    .proof-item:nth-child(n + 3) { border-top: 1px solid var(--color-border); }
    .study-grid { grid-template-columns: 1fr 1fr; }
    .now-list { grid-template-columns: 1fr 1fr; row-gap: 2rem; }
    .featured { grid-template-columns: 1fr; }
    .featured-side { padding-left: 0; border-left: none; padding-top: 1.5rem; border-top: 1px dashed var(--color-border); }
  }

  @media (max-width: 640px) {
    section { padding: 3.25rem 0; }
    .hero { padding: 3.5rem 0 2.5rem; }
    .has-portrait .hero-inner { grid-template-columns: 1fr; }
    .hero-portrait { max-width: 280px; }
    .proof-item, .proof-item + .proof-item { padding: 1.25rem 0.75rem 1.25rem 0; }
    .proof-item:nth-child(even) { padding-left: 0.75rem; }
    .study-grid, .now-list { grid-template-columns: 1fr; }
    .featured { padding: 1.5rem; }
    .project-item { grid-template-columns: 1fr; gap: 0.75rem; }
    .also { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
