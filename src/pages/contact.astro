---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Alex Cruz-Valencia.">

  <section class="contact-hero content-width">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk.</h1>
    <p class="contact-sub">
      Whether it's an APM opportunity, a project collaboration, or just a good
      product conversation — I'm easy to reach.
    </p>
  </section>

  <hr />

  <div class="contact-links content-width">
    <a href="mailto:alexcruzvn@gmail.com" class="contact-row">
      <div class="contact-left">
        <span class="contact-label">Email</span>
        <span class="contact-value">alexcruzvn@gmail.com</span>
      </div>
      <span class="contact-arrow">→</span>
    </a>

    <a
      href="https://www.linkedin.com/in/alex-cruz-valencia"
      target="_blank"
      rel="noopener noreferrer"
      class="contact-row"
    >
      <div class="contact-left">
        <span class="contact-label">LinkedIn</span>
        <span class="contact-value">linkedin.com/in/alex-cruz-valencia</span>
      </div>
      <span class="contact-arrow">↗</span>
    </a>

    <a
      href="https://github.com/Alex-Cruz-Valencia"
      target="_blank"
      rel="noopener noreferrer"
      class="contact-row"
    >
      <div class="contact-left">
        <span class="contact-label">GitHub</span>
        <span class="contact-value">github.com/Alex-Cruz-Valencia</span>
      </div>
      <span class="contact-arrow">↗</span>
    </a>

    <a
      href="/resume.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="contact-row"
    >
      <div class="contact-left">
        <span class="contact-label">Resume</span>
        <span class="contact-value">Download PDF</span>
      </div>
      <span class="contact-arrow">↗</span>
    </a>
  </div>

</Layout>

<style>
  .contact-hero {
    padding: 5.5rem 0 3.5rem;
  }

  .contact-hero h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 1.25rem;
    line-height: 1.0;
  }

  .contact-sub {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 460px;
    line-height: 1.65;
  }

  .contact-links {
    padding: 4rem 0 5rem;
    display: flex;
    flex-direction: column;
  }

  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.875rem 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    transition: all 0.15s;
  }

  .contact-row:first-of-type {
    border-top: 1px solid var(--color-border);
  }

  .contact-row:hover .contact-label {
    color: var(--color-accent);
  }

  .contact-row:hover .contact-arrow {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }

  .contact-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-label {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }

  .contact-value {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    font-weight: 400;
  }

  .contact-arrow {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    transition: color 0.15s, transform 0.15s;
    flex-shrink: 0;
  }
</style>
