---
import Layout from '../layouts/Layout.astro';
import { links, resumeHref } from '../lib/site';

const rows = [
  { label: 'Email', value: links.email, href: `mailto:${links.email}`, arrow: '→', external: false },
  { label: 'LinkedIn', value: 'linkedin.com/in/alex-cruz-valencia', href: links.linkedin, arrow: '↗', external: true },
  { label: 'GitHub', value: 'github.com/Alex-Cruz-Valencia', href: links.github, arrow: '↗', external: true },
  ...(resumeHref ? [{ label: 'Résumé', value: 'Download PDF', href: resumeHref, arrow: '↗', external: true }] : []),
];
---

<Layout title="Contact" description="Get in touch with Alex Cruz-Valencia about Summer 2027 APM and PM internships.">

  <section class="contact-hero content-width">
    <p class="status-pill">Open to Summer 2027 APM / PM internships</p>
    <h1>Let's talk.</h1>
    <p class="contact-sub">
      Recruiting for a PM role, building something in AI, wellness, or learning, or just want to argue
      about a product decision? Email is the fastest way to reach me.
    </p>
  </section>

  <div class="contact-links content-width">
    {rows.map(r => (
      <a
        href={r.href}
        class="contact-row"
        target={r.external ? '_blank' : undefined}
        rel={r.external ? 'noopener noreferrer' : undefined}
      >
        <span class="mono contact-label">{r.label}</span>
        <span class="contact-value">{r.value}</span>
        <span class="contact-arrow" aria-hidden="true">{r.arrow}</span>
      </a>
    ))}
  </div>

</Layout>

<style>
  .contact-hero { padding: 5rem 0 3rem; }

  .contact-hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 1;
    margin: 1.5rem 0 1.25rem;
  }

  .contact-sub {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 560px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-text);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: padding 0.2s var(--ease-out);
  }

  .contact-label { color: var(--color-text-muted); }

  .contact-value {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    overflow-wrap: anywhere;
  }

  .contact-arrow { color: var(--color-accent); font-size: 1.2rem; }

  .contact-row:hover { padding-left: 0.5rem; }
  .contact-row:hover .contact-value { color: var(--color-accent); }

  @media (max-width: 520px) {
    .contact-row { grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem 1rem; }
    .contact-label { grid-column: 1 / -1; }
  }
</style>
