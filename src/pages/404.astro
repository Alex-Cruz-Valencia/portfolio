---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="This page doesn't exist.">
  <section class="not-found content-width">
    <p class="eyebrow">404</p>
    <h1>Wrong turn.</h1>
    <p class="not-found-sub">
      This page doesn't exist. You may have followed a broken link
      or mistyped the URL.
    </p>
    <div class="not-found-actions">
      <a href="/" class="btn">Go home →</a>
      <a href="/contact" class="btn btn-outline">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 7rem 0 6rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .not-found h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 1.25rem;
    line-height: 1.0;
  }

  .not-found-sub {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 420px;
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  .not-found-actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    align-items: center;
  }
</style>
