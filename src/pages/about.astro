---
import Layout from '../layouts/Layout.astro';
import { links, portraitSrc, resumeHref } from '../lib/site';

// A line can be a plain string or { text, href } to link it to the work.
type Line = string | { text: string; href: string; hint: string };

const facts: { label: string; lines: Line[] }[] = [
  {
    label: 'Now',
    lines: [
      { text: 'PM, Evergreen (DALI Lab)', href: '/case-studies/evergreen-design-leadership', hint: 'Case study' },
      { text: 'PM Mentor & Instructor, DALI Lab', href: '/#project-dali-mentor', hint: 'More work' },
    ],
  },
  {
    label: 'Before',
    lines: [
      { text: 'Product Commercialization Intern, EchoStar', href: '/case-studies/echostar-dashboard', hint: 'Case study' },
      { text: 'Product Director, Youphoria', href: '/#project-youphoria', hint: 'More work' },
      { text: 'Research co-lead, Design Corps', href: '/case-studies/design-corps-llc-research', hint: 'Case study' },
    ],
  },
  { label: 'Studying', lines: ['Dartmouth College, Class of 2028', 'B.A. Computer Science, minor in Human-Centered Design'] },
  { label: 'Seeking', lines: ['APM / PM internships, Summer 2027', 'Bay Area, anywhere in California, or remote'] },
  { label: 'Drawn to', lines: ['AI products people have to trust', 'Wellness and behavioral health', 'Learning and education', 'Consumer social'] },
  { label: 'From', lines: ['Salinas, California · now Hanover, NH'] },
];

const principles = [
  {
    title: 'When I can\'t win the decision, I win a way to learn it.',
    body: 'Leadership rejected my permissions recommendation twice. I got them to commit to an A/B test instead, and once real students started onboarding, the evidence finished the argument: 8 became 2.',
    href: '/case-studies/evergreen-design-leadership',
  },
  {
    title: 'Constraints are the spec.',
    body: 'Security rules, data sensitivity, and what execs actually wanted carved an 8-page dashboard down to the 4 it should have been.',
    href: '/case-studies/echostar-dashboard',
  },
  {
    title: 'Find the number that changes the question.',
    body: 'Fewer than a third of new members finished onboarding. That one number turned "market better" into "stop losing people at the door."',
    href: '/case-studies/digital-nest-youth-journey',
  },
  {
    title: 'Comply with the directive, protect the work.',
    body: 'Told to stop interviewing and wait for leadership\'s focus groups, I kept a safety net running. Theirs never happened. The research survived.',
    href: '/case-studies/design-corps-llc-research',
  },
];

const toolkit = [
  { group: 'Research', items: ['Interviews', 'Surveys', 'Journey mapping', 'Usability testing', 'Synthesis'] },
  { group: 'Product', items: ['Figma', 'Jira', 'Miro', 'Notion', 'Experiment design'] },
  { group: 'Data', items: ['SQL', 'Snowflake', 'Streamlit', 'Python'] },
  { group: 'AI & building', items: ['LLM tool calling', 'Memory design', 'Claude Code', 'Cursor', 'Codex', 'Gemini Gems', 'Next.js', 'TypeScript'] },
];

const community = [
  'Officer, Dartmouth Society of Computer Science Students',
  'Dartmouth Tech Consulting Group (formerly UX/UI designer)',
  'QuestBridge Scholar',
  'SHPE · ALPFA · ColorStack',
];
---

<Layout
  title="About"
  description="About Alex Cruz-Valencia: CS and Human-Centered Design at Dartmouth, PM for Evergreen, first-gen from Salinas, CA. Seeking Summer 2027 APM/PM internships."
>

  <section class="about-hero container">
    <div class="about-hero-copy">
      <p class="eyebrow">About</p>
      <h1>I ask who it's for. Then I go <em>ask them</em>.</h1>
    </div>
    {portraitSrc && (
      <img class="about-portrait" src={portraitSrc} alt="Alex Cruz-Valencia" width="420" height="525" />
    )}
  </section>

  <div class="about-body container">
    <div class="bio">
      <p class="bio-lead">
        I'm Alex: first-gen, QuestBridge Scholar, and a Computer Science and Human-Centered Design
        student at Dartmouth. I speak English and Spanish.
      </p>

      <div class="bio-blocks">
        <section class="bio-block">
          <h2 class="mono">Where I'm from</h2>
          <p>
            Salinas, California. I was a member at Digital NEST, a nonprofit that gives young people a path
            into tech, then an instructor there. In Salinas, the NEST is more than a community. It's a family.
          </p>
        </section>
        <section class="bio-block">
          <h2 class="mono">What I do now</h2>
          <p>
            I'm the PM for <a href="https://evergreen.dartmouth.edu/" target="_blank" rel="noopener noreferrer">Evergreen</a>,
            Dartmouth's AI wellness app, in testing with about 200 students. I own the parts that decide whether
            students trust it: what its AI can do for them, and what it remembers.
          </p>
        </section>
        <section class="bio-block">
          <h2 class="mono">How I think</h2>
          <p>
            I can read a schema and I can run a user interview, and I think both belong in the room. I test my
            own ideas first, which is why <a href="/#project-puente">Puente</a> is still in validation, not in the App Store.
          </p>
        </section>
        <section class="bio-block">
          <h2 class="mono">Outside work</h2>
          <p>
            I box, play poker, and build custom keyboards. I also sew my own clothes, which taught me more about
            cutting scope than any PM book: you measure the person, not the pattern.
          </p>
        </section>
      </div>

      <div class="about-ctas">
        <a href="/contact" class="btn">Get in touch →</a>
        {resumeHref && <a href={resumeHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">Résumé (PDF)</a>}
        <a href={links.linkedin} class="btn btn-outline" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </div>

    <aside class="about-aside" aria-label="Quick facts">
      <dl>
        {facts.map(f => (
          <div class="aside-block">
            <dt class="mono">{f.label}</dt>
            {f.lines.map(l => typeof l === 'string'
              ? <dd>{l}</dd>
              : (
                <dd class="fact-link-wrap">
                  <a href={l.href} class="fact-link">
                    <span class="fact-text">{l.text}</span>
                    <span class="fact-arrow" aria-hidden="true">→</span>
                    <span class="mono fact-hint">{l.hint}</span>
                  </a>
                </dd>
              ))}
          </div>
        ))}
      </dl>
    </aside>
  </div>

  <section class="container about-section" aria-labelledby="principles-title">
    <div class="section-label">
      <h2 id="principles-title">How I work</h2>
      <span class="mono">Lessons I paid for</span>
    </div>
    <ol class="principle-grid" role="list">
      {principles.map((p, i) => (
        <li class="principle">
          <span class="mono principle-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <a href={p.href} class="principle-link">The full story →</a>
        </li>
      ))}
    </ol>
  </section>

  <section class="container about-section" aria-labelledby="toolkit-title">
    <div class="section-label">
      <h2 id="toolkit-title">Toolkit</h2>
      <span class="mono">What I reach for</span>
    </div>
    <div class="toolkit">
      {toolkit.map(t => (
        <div class="tool-group">
          <p class="mono tool-label">{t.group}</p>
          <ul role="list">
            {t.items.map(i => <li class="tag">{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container about-section" aria-labelledby="community-title">
    <div class="section-label">
      <h2 id="community-title">On campus</h2>
    </div>
    <ul class="community" role="list">
      {community.map(c => <li>{c}</li>)}
    </ul>
  </section>

</Layout>

<style>
  .bio-blocks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 2rem; margin: 2rem 0 2.25rem; }
  .bio-block { padding-top: 1rem; border-top: 2px solid var(--color-text); }
  .bio-block h2 { font-size: 0.75rem; color: var(--color-accent); margin-bottom: 0.6rem; font-weight: 400; letter-spacing: 0.02em; }
  .bio .bio-block p { font-size: 1rem; line-height: 1.6; margin: 0; color: var(--color-text-secondary); }
  .bio-block a { color: var(--color-text); border-bottom: 1px solid var(--color-accent); }
  @media (max-width: 640px) { .bio-blocks { grid-template-columns: 1fr; } }

  .about-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    padding-top: 5rem;
    padding-bottom: 3rem;
  }

  .about-hero h1 {
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.05;
    margin-top: 1.25rem;
    max-width: 22ch;
  }

  .about-hero h1 em { font-style: italic; color: var(--color-accent); }

  .about-portrait {
    width: 260px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-text);
  }

  .bio p {
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: 1.35rem;
  }

  .bio .bio-lead {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.45;
  }

  .bio strong { font-weight: 600; }

  .bio p a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .about-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .about-aside dl {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 1.6rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .aside-block dt { color: var(--color-accent); margin-bottom: 0.25rem; }

  .aside-block dd {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Linked roles: a whole-row hit area that nudges right and turns green. */
  .aside-block dd.fact-link-wrap { margin: 0 -0.6rem; }

  .fact-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'text arrow' 'hint hint';
    align-items: start;
    column-gap: 0.75rem;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    color: var(--color-text);
    transition: background 0.2s var(--ease-out), color 0.2s;
  }

  .fact-text {
    grid-area: text;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s var(--ease-out);
  }

  .fact-arrow {
    grid-area: arrow;
    color: var(--color-text-muted);
    transition: transform 0.25s var(--ease-out), color 0.2s;
  }

  .fact-hint {
    grid-area: hint;
    font-size: 0.68rem;
    color: var(--color-text-muted);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.25s var(--ease-out), opacity 0.2s;
  }

  .fact-link:hover,
  .fact-link:focus-visible {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .fact-link:hover .fact-text,
  .fact-link:focus-visible .fact-text { background-size: 100% 1px; }

  .fact-link:hover .fact-arrow,
  .fact-link:focus-visible .fact-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .fact-link:hover .fact-hint,
  .fact-link:focus-visible .fact-hint {
    max-height: 1.2rem;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .fact-link, .fact-text, .fact-arrow, .fact-hint { transition: none; }
  }

  .about-section { padding-top: 4.5rem; }

  /* ── Principles ── */
  .principle-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: -2rem;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem 2rem 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .principle:nth-child(even) {
    padding-left: 2rem;
    padding-right: 0;
    border-left: 1px solid var(--color-border);
  }

  .principle-num { color: var(--color-text-muted); }

  .principle h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.2;
  }

  .principle p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .principle-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-accent);
  }



  .toolkit {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .tool-label { color: var(--color-text-muted); margin-bottom: 0.6rem; }

  .tool-group ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .community {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 2rem;
    color: var(--color-text-secondary);
  }

  .community li { padding-left: 1.2rem; position: relative; }

  .community li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .about-body { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-aside dl { position: static; }
    .toolkit { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .about-hero { flex-direction: column-reverse; align-items: flex-start; padding-top: 3rem; }
    .about-portrait { width: 180px; }
    .toolkit, .community, .principle-grid { grid-template-columns: 1fr; }
    .principle, .principle:nth-child(even) { padding: 1.5rem 0; border-left: none; }
  }
</style>
